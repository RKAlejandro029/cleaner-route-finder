# Routing/geocoding provider fallback chain — server-side only, never
# exposed to the browser. The app tries these in order (1 -> 2 -> 3) on
# every request; if one errors or hits its quota, the next is tried
# automatically. Only OPENROUTESERVICE_API_KEY is required; the others
# are optional but recommended if you expect to exceed ORS's free-tier
# daily limit.

# 1. OpenRouteService (primary) — free, no card required
# Sign up: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=your_ors_key_here

# 2. GraphHopper (fallback) — free tier, no card required
# Sign up: https://www.graphhopper.com/dashboard/#/register
GRAPHHOPPER_API_KEY=

# 3. Mapbox (last resort) — free tier, requires a card on file
# Sign up: https://account.mapbox.com/auth/signup/
MAPBOX_ACCESS_TOKEN=

# Launch27/Automaid API — server-side only, never exposed to the browser.
# Requires OFFICE STAFF credentials (not a customer login) — the login
# response's "type" must be Tenant::Admin or Tenant::Staff.
LAUNCH27_SUBDOMAIN=leblanccleaning
LAUNCH27_EMAIL=staff@example.com
LAUNCH27_PASSWORD=your_staff_password

# Only needed if this staff account has 2FA enabled. NOTE: since this is a
# static value (not a live TOTP generator), it only works if your account
# doesn't rotate codes -- for most 2FA setups you'll need to disable 2FA on
# this specific service account instead.
LAUNCH27_OTP=

# Google Sheets route-geometry cache — server-side only. Optional, but
# recommended: without this, every date load re-routes from scratch even
# if that day's schedule hasn't changed since last time. See README for
# full setup steps (service account, sharing the sheet, tab name).
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
